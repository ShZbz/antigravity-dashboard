{
  "name": "antigrative-dashboard",
  "version": "0.12.6",
  "private": true,
  "description": "Compact Antigravity token throughput and quota widget",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test sidecars/panel/tests/*.test.mjs cli/tests/*.test.mjs",
    "preview:cli": "node cli/statusline.mjs --preview",
    "test:lifecycle": "python -m unittest discover -s tests -v",
    "test:ui": "node tools/ui-runner.mjs --suite ui",
    "preview:motion": "node tools/check-density-motion.mjs --preview",
    "package": "node manage.mjs package && node ide/package.mjs",
    "test:ide": "node --test ide/tests/*.test.mjs && node tools/check-ide-ui.mjs",
    "test:usage-ui": "node tools/ui-runner.mjs --suite usage",
    "test:panel-ui": "node tools/check-panel-ui.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
